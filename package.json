{
  "name": "aws-ip-atlas",
  "version": "1.0.0",
  "description": "Live, searchable map of every AWS public IP range (ip-ranges.json): lookup, history since 2015, allowlist builder and plain-text API.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "update": "node scripts/update.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "backfill": "node scripts/backfill-wayback.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": ["aws", "ip-ranges", "aws-ip-ranges", "cidr", "allowlist", "cloudfront", "hilbert-curve"]
}
